--- !u!114 &7764420616612563177
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 499597054137291936}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8da02ff813d339d46aa5c25a57b87c81, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GuideUI
  _imageUI: {fileID: 8273518915918167160}
  _textUI: {fileID: 8462273538378413210}
  _guideImages:
  - {fileID: 21300000, guid: 4f58e89ec508edd4889dd81168ccd259, type: 3}
  - {fileID: 21300000, guid: fdc0cddd663c55e4e8abfe76dafde034, type: 3}
  - {fileID: 21300000, guid: be0c94f12cadbb444845435e3787f0b0, type: 3}
  - {fileID: 21300000, guid: 623e6aa608c65904d914483c1d378cc9, type: 3}
  - {fileID: 21300000, guid: 8ffed116a27d0e446af0614871dc8ce7, type: 3}
  - {fileID: 21300000, guid: b1ac3a0e812d19c4eb91e9b1b75a1168, type: 3}
  - {fileID: 21300000, guid: 7ada1b3f49eab744b901079762ec9459, type: 3}
  _descriptions:
  - "\uB9C8\uC6B0\uC2A4\uB97C \uD074\uB9AD\uD558\uC5EC \uC801\uC744 <#FFCC00>\uACF5\uACA9</color>\uD558\uC138\uC694!"
  - "3\uD68C \uC5F0\uC18D \uACF5\uACA9 \uD6C4, \uB9C8\uC6B0\uC2A4\uB97C \uAE38\uAC8C
    \uB20C\uB7EC <#FFCC00>\uAC15\uB825\uD55C \uC77C\uACA9</color>\uC744 \uB0A0\uB9AC\uC138\uC694!"
  - "<#FFCC00>Shift</color> \uD0A4\uB97C \uB20C\uB7EC \uB2EC\uB9AC\uC138\uC694.\n\uADF8\uB9AC\uACE0
    \uC810\uD504 \uD6C4 \uACF5\uACA9\uD558\uC5EC <#FFCC00>\uB300\uC26C \uACF5\uACA9</color>\uC744
    \uBC1C\uB3D9\uD558\uC138\uC694!"
  - "\uC7A0\uB4E0 \uB8EC\uC758 \uD798\uC744 \uAE68\uC6B0\uC138\uC694! \n\uB3D9\uC77C\uD55C
    \uB8EC\uC744 \uC7AC\uB8CC\uB85C \uC0AC\uC6A9\uD558\uC5EC <#FFCC00>\uC2B9\uAE09</color>\uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uB8EC\uC744 \uC120\uD0DD\uD574 \uC2AC\uB86F\uC5D0 <#FFCC00>\uC7A5\uCC29</color>\uD558\uACE0,
    \uB354\uBE14\uD074\uB9AD\uC73C\uB85C \uAC04\uD3B8\uD558\uAC8C <#FFCC00>\uD574\uC81C</color>\uD558\uC138\uC694."
  - "\uB8EC\uC744 \uD310\uB9E4\uD558\uC5EC <#FFCC00>\uACE8\uB4DC</color>\uB97C \uD68D\uB4DD\uD558\uC138\uC694."
  - "<#FFCC00>Q, E, R</color> \uD0A4\uB97C \uB20C\uB7EC \uC7A5\uCC29\uD55C \uB8EC\uC758
    \uACE0\uC720 \uAE30\uC220\uC744 \uC0AC\uC6A9\uD558\uC138\uC694."
